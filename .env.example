# ==============================================================================
# AegisVoice - Configuration & API Keys
# ==============================================================================

# AssemblyAI API Key (Required for Real-time Streaming STT)
# Get your key from https://www.assemblyai.com/dashboard
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here

# LLM Providers (Provide at least one)
# Groq is recommended for ultra-fast Time-To-First-Token (TTFT)
GROQ_API_KEY=your_groq_api_key_here
# Or OpenAI API Key
OPENAI_API_KEY=your_openai_api_key_here

# Preferred LLM Provider: "groq" or "openai"
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile

# TTS Provider: "edge" (default, high quality & free), "cartesia", "deepgram", or "openai"
TTS_PROVIDER=edge
TTS_VOICE=en-US-GuyNeural

# Server Configuration
HOST=0.0.0.0
PORT=8080
DEBUG=true
